{
  "name": "maimai-tournament-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,SERVER -c cyan,magenta \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
